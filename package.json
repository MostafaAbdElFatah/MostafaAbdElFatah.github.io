{
  "name": "mostafa-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node src/tools/build-icons.mjs",
    "images": "node src/tools/optimize-images.mjs",
    "images:fallback": "node src/tools/crop-board-fallback.mjs",
    "render:fallback": "node src/tools/render-static-projects.mjs && prettier --write src/pages/index.html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.66.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.5",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^5.0.5"
  }
}
